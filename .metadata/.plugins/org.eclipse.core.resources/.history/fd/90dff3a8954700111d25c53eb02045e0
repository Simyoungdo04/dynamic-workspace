<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<style>
	ul{
		list-style: none;
		line-height: 200%;
	}
</style>
</head>
<body>
	<h1>연습</h1>
	<form method="get" action="http://localhost:8088/first/practice.do">
		<ul>
			<li>
				이름 : <input type="text" name="name"/>
			</li>
			<li>
				포지션 : 
				<select name="position">
					<option>공격수</option>
					<option>미드필더</option>
					<option>수비수</option>
				</select>
			</li>
			<li>
				키 : <input type="range" min="160" max="210" name="height"/>
			</li>
			<li>
				몸무게 : <input type="range" min="50" max="120" name="weight"/>
			</li>
			<li>
				주발 : 
				왼발 <input type="radio" name="leftFoot"/>
				오른발 <input type="radio" name="rightFoot"/>
			</li>
			<li>
				플레이 스타일 : 
				개인플레이 <input type="checkbox" name="playStyle"/>
				플레이메이커 <input type="checkbox" name="playStyle"/>
				개인기 <input type="checkbox" name="playStyle"/>
				슛터 <input type="checkbox" name="playStyle"/>
				틀러블러 <input type="checkbox" name="playStyle"/>
			</li>
			<li>
				
			</li>
			<li>
				
			</li>
			<li>
				
			</li>
			<li>
				<button type="submit">제출</button>
			</li>
		</ul>
	</form>
</body>
</html>